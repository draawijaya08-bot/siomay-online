# =============================================================================
# SIOMAY ONLINE — SUPABASE ENVIRONMENT CONFIGURATION
# =============================================================================
# Salin file ini menjadi `.env` dan isi dengan kredensial Supabase proyek kamu.
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
# =============================================================================

# Client-side (Vite Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side (Backend API / Vercel Serverless / Edge Functions)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
