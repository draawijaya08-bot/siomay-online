# =============================================================================
# SIOMAY ONLINE — SUPABASE ENVIRONMENT CONFIGURATION
# =============================================================================
# Salin file ini menjadi `.env` dan isi dengan kredensial Supabase proyek kamu.
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
# =============================================================================

# Supabase Project URL (Contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public Key aman untuk client browser)
VITE_SUPABASE_ANON_KEY=your-anon-public-key
